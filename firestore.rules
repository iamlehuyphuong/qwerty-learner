rules_version = '2';

// Cấu trúc dữ liệu: xem src/lib/cloudSync.ts
//   users/{uid}                                   client chỉ ghi settings/progress; hồ sơ, donate, thống kê, streak do server ghi
//   users/{uid}/history/{autoId}                  log từng lần luyện tập (chỉ thêm mới)
//   users/{uid}/chapterProgress/{dictId}__{ch}    tổng hợp từng bài đã hoàn thành
//   users/{uid}/wordRecords, dailyStats           lịch sử từng từ & tổng hợp theo ngày (src/lib/syncWordRecords.ts)
//   userCodes/{code}, publicProfiles/{uid}        chỉ server ghi
//
// Server (Cloud Functions, Admin SDK) bỏ qua rules: functions/index.js
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function data() {
      return request.resource.data;
    }

    function isNonNegativeNumber(value) {
      return value is number && value >= 0;
    }

    // ---------- users/{uid} ----------

    // Field client được ghi. Các field còn lại (uid, code, email, name, isDonated, totalDonate,
    // totalTimeSpentMs, totalChapters, totalWords, streak, createdAt...) chỉ server ghi
    function clientUserKeys() {
      return ['settings', 'settingsUpdatedAt', 'progress', 'updatedAt'];
    }

    function isValidProgress(progress) {
      return progress is map
        && progress.keys().hasOnly(['dictId', 'chapter', 'updatedAt'])
        && progress.dictId is string && progress.dictId.size() > 0 && progress.dictId.size() <= 200
        && progress.chapter is int && progress.chapter >= 0
        && (!('updatedAt' in progress) || progress.updatedAt is timestamp);
    }

    function isValidClientUserData() {
      return (!('settings' in data()) || data().settings is map)
        && (!('settingsUpdatedAt' in data()) || data().settingsUpdatedAt is timestamp)
        && (!('progress' in data()) || isValidProgress(data().progress))
        && (!('updatedAt' in data()) || data().updatedAt is timestamp);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      // Cloud sync có thể tạo document trước khi server tạo hồ sơ (setDoc merge)
      allow create: if isOwner(uid)
        && data().keys().hasOnly(clientUserKeys())
        && isValidClientUserData();

      // Chỉ kiểm tra các field client thay đổi, để field do server thêm không làm hỏng lệnh ghi
      allow update: if isOwner(uid)
        && data().diff(resource.data).affectedKeys().hasOnly(clientUserKeys())
        && isValidClientUserData();

      allow delete: if false;

      // ---------- users/{uid}/history/{logId} ----------
      match /history/{logId} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && data().keys().hasOnly([
            'dictID', 'chapter', 'timeSpentMs', 'accuracy', 'correctCount',
            'wrongCount', 'wordCount', 'wpm', 'isRevision', 'timestamp',
          ])
          && data().dictID is string
          && data().chapter is int && data().chapter >= -1
          && isNonNegativeNumber(data().timeSpentMs)
          && isNonNegativeNumber(data().correctCount)
          && isNonNegativeNumber(data().wrongCount)
          && isNonNegativeNumber(data().wordCount)
          && isNonNegativeNumber(data().wpm)
          && (!('accuracy' in data()) || isNonNegativeNumber(data().accuracy))
          && data().isRevision is bool
          && data().timestamp == request.time;

        // Lịch sử chỉ thêm mới, không sửa/xoá
        allow update, delete: if false;
      }

      // ---------- users/{uid}/chapterProgress/{progressId} ----------
      match /chapterProgress/{progressId} {
        function isValidChapterProgress() {
          return data().keys().hasOnly([
              'dictId', 'chapter', 'completedCount', 'totalTimeSpentMs', 'bestWpm',
              'lastWpm', 'lastAccuracy', 'lastWrongCount', 'firstCompletedAt', 'lastCompletedAt',
            ])
            && data().dictId is string
            && data().chapter is int && data().chapter >= 0
            && progressId == data().dictId + '__' + string(data().chapter)
            && data().completedCount is int
            && isNonNegativeNumber(data().totalTimeSpentMs)
            && isNonNegativeNumber(data().bestWpm)
            && isNonNegativeNumber(data().lastWpm)
            && isNonNegativeNumber(data().lastAccuracy) && data().lastAccuracy <= 100
            && isNonNegativeNumber(data().lastWrongCount)
            && data().firstCompletedAt is int
            && data().lastCompletedAt is int
            && data().bestWpm >= data().lastWpm;
        }

        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && isValidChapterProgress()
          && data().completedCount == 1;

        // Mỗi lần hoàn thành bài chỉ được tăng đúng 1 lần, số liệu cộng dồn không được giảm
        allow update: if isOwner(uid)
          && isValidChapterProgress()
          && data().dictId == resource.data.dictId
          && data().chapter == resource.data.chapter
          && data().completedCount == resource.data.completedCount + 1
          && data().totalTimeSpentMs >= resource.data.totalTimeSpentMs
          && data().bestWpm >= resource.data.bestWpm
          && data().firstCompletedAt == resource.data.firstCompletedAt;

        allow delete: if false;
      }

      // ---------- users/{uid}/wordRecords/{recordId} ----------
      // ID tính từ nội dung bản ghi (src/lib/syncWordRecords.ts). Chỉ tạo mới, không cho ghi đè:
      // batch đẩy lại bản ghi đã có sẽ bị từ chối toàn bộ nên dailyStats đi kèm không bị cộng trùng
      match /wordRecords/{recordId} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && data().keys().hasOnly([
            'word', 'dict', 'chapter', 'timeStamp', 'timing', 'wrongCount', 'mistakes', 'hasError', 'syncedAt',
          ])
          && data().word is string && data().word.size() > 0 && data().word.size() <= 200
          && data().dict is string && data().dict.size() > 0 && data().dict.size() <= 200
          && (data().chapter == null || (data().chapter is int && data().chapter >= -1))
          && data().timeStamp is int && data().timeStamp > 0
          && data().timing is list && data().timing.size() <= 500
          && data().wrongCount is int && data().wrongCount >= 0
          && data().mistakes is map
          && data().hasError == (data().wrongCount > 0)
          && data().syncedAt == request.time;

        allow update: if false;

        // Xoá từ trong Error Book
        allow delete: if isOwner(uid);
      }

      // ---------- users/{uid}/dailyStats/{date} ----------
      // Tổng hợp theo ngày, client cộng dồn bằng increment/arrayUnion. Các bộ đếm không được giảm
      match /dailyStats/{date} {
        function isValidDailyStats() {
          return data().keys().hasOnly([
              'date', 'exerciseCount', 'totalTimeMs', 'wrongCount', 'totalChars', 'words', 'wrongKeys', 'updatedAt',
            ])
            && data().date == date
            && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && isNonNegativeNumber(data().exerciseCount)
            && isNonNegativeNumber(data().totalTimeMs)
            && isNonNegativeNumber(data().wrongCount)
            && isNonNegativeNumber(data().totalChars)
            && data().words is list && data().words.size() <= 10000
            && data().wrongKeys is map
            && data().updatedAt == request.time;
        }

        allow read: if isOwner(uid);

        allow create: if isOwner(uid) && isValidDailyStats();

        allow update: if isOwner(uid)
          && isValidDailyStats()
          && data().exerciseCount >= resource.data.exerciseCount
          && data().totalTimeMs >= resource.data.totalTimeMs
          && data().wrongCount >= resource.data.wrongCount
          && data().totalChars >= resource.data.totalChars;

        allow delete: if false;
      }
    }

    // ---------- donations/{transactionCode} ----------
    // Chỉ Admin SDK (Cloud Functions) mới được ghi.
    // User có thể đọc donation đã match với mình.
    match /donations/{transactionCode} {
      allow read: if request.auth != null && resource.data.matchedUserId == request.auth.uid;
      allow write: if false; // Chỉ Admin SDK mới ghi được (bỏ qua rules)
    }

    // ---------- publicProfiles/{uid} ----------
    // Dùng cho Leaderboard (Bảng xếp hạng). Chỉ server ghi (functions: ensureUserProfile, onHistoryCreated)
    match /publicProfiles/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ---------- userCodes/{code} ----------
    // Mã donate -> uid, đảm bảo mã không trùng. Chỉ server dùng
    match /userCodes/{code} {
      allow read, write: if false;
    }

    // Mặc định chặn mọi thứ khác
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
